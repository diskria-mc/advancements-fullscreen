                mkdir -p "${LOGS_DIRECTORY_PATH}"
                CLIENT_LOG_PATH="${LOGS_DIRECTORY_PATH}/craftClient_${LOADER}_${TARGET_VERSION}_$(date +%Y-%m-%d_%H-%M-%S).log"
                ./gradlew :${LOADER}:${MOD_PROJECT_NAME}:craftClient -Dcrafter.flow=single -Dcrafter.loader=${LOADER} -Dcrafter.version=${TARGET_VERSION} -Dcrafter.modProjectName=${MOD_PROJECT_NAME} --no-daemon --stacktrace > ${CLIENT_LOG_PATH} 2>&1 &
                CLIENT_PID="$!"
                LINE=""
                while IFS='' read -r LINE; do
                    if [[ ${IS_CLIENT_RUNNING} -eq 1 ]]; then
                        if echo "${LINE}" | grep -Fq "[Render thread/" || echo "${LINE}" | grep -Fq "[LWJGL]" || echo "${LINE}" | grep -Fq "fps,"; then
                            IS_CLIENT_RUNNING=0
                            echo "${IS_CLIENT_RUNNING}" >&$IS_CLIENT_RUNNING_FD
                            exec {IS_CLIENT_RUNNING_FD}>&-
                        fi
                    fi
                    echo "${LINE}" >&$LAST_CLIENT_LOG_LINE_FD
                done < <(tail -F "${CLIENT_LOG_PATH}" --pid="${CLIENT_PID}" -n 0) &
                CLIENT_LOG_WATCHER_PID="$!"
            }
            while true; do
                if [[ ${IS_SERVER_RUNNING} -eq 1 ]]; then
                    IS_SERVER_RUNNING_FD_DATA=""
                    if [[ -e /proc/$$/fd/$IS_SERVER_RUNNING_FD ]] && IFS='' read -r -t 0.01 IS_SERVER_RUNNING_FD_DATA <&$IS_SERVER_RUNNING_FD 2>/dev/null; then
                        IS_SERVER_RUNNING="${IS_SERVER_RUNNING_FD_DATA}"
                        rm -f "${IS_SERVER_RUNNING_FIFO}"
                    fi
                    if [[ ${IS_SERVER_RUNNING} -eq 0 ]]; then
                        run_client
                    fi
                elif [[ ${IS_CLIENT_RUNNING} -eq 1 ]]; then
                    IS_CLIENT_RUNNING_FD_DATA=""
                    if [[ -e /proc/$$/fd/$IS_CLIENT_RUNNING_FD ]] && IFS='' read -r -t 0.01 IS_CLIENT_RUNNING_FD_DATA <&$IS_CLIENT_RUNNING_FD 2>/dev/null; then
                        IS_CLIENT_RUNNING="${IS_CLIENT_RUNNING_FD_DATA}"
                        rm -f "${IS_CLIENT_RUNNING_FIFO}"
                    fi
                fi
                if [[ ${IS_SERVER_RUNNING} -eq 0 ]]; then
                    echo -en "\033[1A"
                    LAST_CLIENT_LOG_LINE_FD_DATA=""
                    if [[ -e /proc/$$/fd/$LAST_CLIENT_LOG_LINE_FD ]] && IFS='' read -r -t 0.01 LAST_CLIENT_LOG_LINE_FD_DATA <&$LAST_CLIENT_LOG_LINE_FD 2>/dev/null; then
                        LAST_CLIENT_LOG_LINE="${LAST_CLIENT_LOG_LINE_FD_DATA}"
                    fi
                    if [[ -n "${LAST_CLIENT_LOG_LINE}" ]]; then
                        echo -en "\r\033[2K"
                        echo -e -n "\033[35m[CLIENT]\033[0m"
                        echo -e -n " "
                        echo -e -n "${LAST_CLIENT_LOG_LINE}"
                        echo -en "\033[1B"
                        echo "" >&$LAST_CLIENT_LOG_LINE_FD
                    fi
                fi
                LAST_SERVER_LOG_LINE_FD_DATA=""
                if [[ -e /proc/$$/fd/$LAST_SERVER_LOG_LINE_FD ]] && IFS='' read -r -t 0.01 LAST_SERVER_LOG_LINE_FD_DATA <&$LAST_SERVER_LOG_LINE_FD 2>/dev/null; then
                    LAST_SERVER_LOG_LINE="${LAST_SERVER_LOG_LINE_FD_DATA}"
                fi
                if [[ -n "${LAST_SERVER_LOG_LINE}" ]]; then
                    echo -en "\r\033[2K"
                    echo -e -n "\033[33m[SERVER]\033[0m"
                    echo -e -n " "
                    echo -e -n "${LAST_SERVER_LOG_LINE}"
                    echo -en "\033[1B"
                    echo "" >&$LAST_SERVER_LOG_LINE_FD
                fi
                echo -en "\r\033[2K"
                if kill -0 "${SERVER_PID}" 2>/dev/null; then
                    if [[ ${IS_SERVER_RUNNING} -eq 0 ]]; then
                        echo -e -n "\033[32mMinecraft\033[0m"
                        echo -e -n "\033[1;32m server\033[0m"
                        echo -e -n "\033[32m is running...\033[0m"
                        echo -e -n "\033[90m (Press \033[0m"
                        echo -e -n "\033[1;90m<Ctrl+C>\033[0m"
                        echo -e -n "\033[90m to stop)\033[0m"
                    else
                        SPINNER_CHAR="${SPINNER_CHARS:((${SPINNER_PROGRESS} % SPINNER_LENGTH)):1}"
                        echo -e -n "\033[36m${SPINNER_CHAR}\033[0m"
                        echo -e -n "\033[36m Crafting \033[0m"
                        echo -e -n "\033[36mMinecraft\033[0m"
                        echo -e -n "\033[1;36m server\033[0m"
                        echo -e -n "\033[36m...\033[0m"
                        ((SPINNER_PROGRESS++))
                    fi
                else
                    if [[ -z ${SERVER_EXIT_CODE} ]]; then
                        wait ${SERVER_PID}
                        EXIT_CODE=$?
                        SERVER_EXIT_CODE=${EXIT_CODE}
                    fi
                    if [[ ${SERVER_EXIT_CODE} -eq 0 ]]; then
                        echo -e -n "\033[90mMinecraft\033[0m"
                        echo -e -n "\033[1;90m server\033[0m"
                        echo -e -n "\033[90m closed.\033[0m"
                    else
                        echo -e -n "\033[31mMinecraft\033[0m"
                        echo -e -n "\033[1;31m server\033[0m"
                        echo -e -n "\033[31m crashed. \033[0m"
                        echo -e -n "\033[90mSee full log at $(realpath "${SERVER_LOG_PATH}")\033[0m"
                    fi
                fi
                if [[ ${IS_SERVER_RUNNING} -eq 0 ]]; then
                    echo -e ""
                    echo -en "\r\033[2K"
                    if kill -0 "${CLIENT_PID}" 2>/dev/null; then
                        if [[ ${IS_CLIENT_RUNNING} -eq 0 ]]; then
                            echo -e -n "\033[32mMinecraft\033[0m"
                            echo -e -n "\033[1;32m client\033[0m"
                            echo -e -n "\033[32m is running...\033[0m"
                            echo -e -n "\033[90m (Press \033[0m"
                            echo -e -n "\033[1;90m<Ctrl+C>\033[0m"
                            echo -e -n "\033[90m to stop)\033[0m"
                        else
                            SPINNER_CHAR="${SPINNER_CHARS:((${SPINNER_PROGRESS} % SPINNER_LENGTH)):1}"
                            echo -e -n "\033[36m${SPINNER_CHAR}\033[0m"
                            echo -e -n "\033[36m Crafting \033[0m"
                            echo -e -n "\033[36mMinecraft\033[0m"
                            echo -e -n "\033[1;36m client\033[0m"
                            echo -e -n "\033[36m...\033[0m"
                            ((SPINNER_PROGRESS++))
                        fi
                    else
                        if [[ -z ${CLIENT_EXIT_CODE} ]]; then
                            wait ${CLIENT_PID}
                            EXIT_CODE=$?
                            CLIENT_EXIT_CODE=${EXIT_CODE}
                        fi
                        if [[ ${CLIENT_EXIT_CODE} -eq 0 ]]; then
                            echo -e -n "\033[90mMinecraft\033[0m"
                            echo -e -n "\033[1;90m client\033[0m"
                            echo -e -n "\033[90m closed.\033[0m"
                        else
                            echo -e -n "\033[31mMinecraft\033[0m"
                            echo -e -n "\033[1;31m client\033[0m"
                            echo -e -n "\033[31m crashed. \033[0m"
                            echo -e -n "\033[90mSee full log at $(realpath "${CLIENT_LOG_PATH}")\033[0m"
                        fi
                    fi
                fi
            done
        fi
    ;;
    help)
        echo -e ""
        echo -e "\033[1;33m     __ __    ______     ______     ______     ______    ______    ______     ______    \033[0m"
        echo -e "\033[33m  __/ // /_  /\  ___\   /\  == \   /\  __ \   /\  ___\  /\__  _\  /\  ___\   /\  == \   \033[0m"
        echo -e "\033[33m /_  _  __/  \ \ \____  \ \  __<   \ \  __ \  \ \  __\  \/_/\ \/  \ \  __\   \ \  __<   \033[0m"
        echo -e "\033[33m/_  _  __/    \ \_____\  \ \_\ \_\  \ \_\ \_\  \ \_\       \ \_\   \ \_____\  \ \_\ \_\ \033[0m"
        echo -e "\033[33m /_//_/        \/_____/   \/_/ /_/   \/_/\/_/   \/_/        \/_/    \/_____/   \/_/ /_/ \033[0m"
        echo -e ""
        echo -e "                                      \033[1;35mCLI v0.3.6\033[0m"
        echo -e "                                      \033[1;35m──────────\033[0m"
        echo -e ""
        echo -e -n "\033[1;32mUsage: \033[0m"
        echo -e "./crafter <command> [arguments]"
        echo -e ""
        echo -e "\033[1;32mCommands:\033[0m"
        echo -e "  init <loader> <version>                      Create and initialize new mod project"
        echo -e "  craft <loader> <version> <side>              Build the mod and launch the selected Minecraft side"
        echo -e "  port <loader> <step> <direction> <strategy>  Port mod to older or newer versions"
        echo -e "  help                                         Show this message"
        echo -e ""
        echo -e "\033[1;32mArguments:\033[0m"
        echo -e "  loader        Name of mod loader"
        echo -e "  version       Target Minecraft version"
        echo -e "                "
        echo -e "  side          Game side to build and launch"
        echo -e "   │            "
        echo -e "   ├─ client*     Build the mod and launch the Minecraft client"
        echo -e "   ├─ server      Build the mod and launch the Minecraft server"
        echo -e "   └─ launcher    Interactive mode for launching server and multiple clients"
        echo -e "                "
        echo -e "  step          Porting workflow step"
        echo -e "   │            "
        echo -e "   ├─ start       Start porting to the next Minecraft version"
        echo -e "   ├─ continue    The mod works on this version — proceed to the next one"
        echo -e "   ├─ stop        The mod is broken on this version — stop porting here"
        echo -e "   ├─ cancel      Cancel the current port and delete the temporary project"
        echo -e "   └─ test        Re-test the mod on the current target version"
        echo -e "                "
        echo -e "  direction     Porting direction"
        echo -e "   │            "
        echo -e "   ├─ past*       Port to older Minecraft versions (backport)"
        echo -e "   └─ future      Port to newer Minecraft versions (forward-port)"
        echo -e "                "
        echo -e "  strategy      Porting test strategy"
        echo -e "   │            "
        echo -e "   ├─ pending*    Build + launch game, wait for your approval"
        echo -e "   └─ auto        Build-only, no launch, continue on success, stop on crash"
        echo -e ""
        echo -e "\033[1;90mLegend:\033[0m"
        echo -e "  *  default option (used when none specified)"
    ;;
    *)
        echo -e -n "\033[31mUnknown command: \033[0m"
        echo -e -n "\033[1;31m'${1-}'\033[0m"
        echo -e ""
        echo -e -n "\033[90mTip: run \033[0m"
        echo -e -n "\033[1;90m'./crafter help'\033[0m"
        echo -e -n "\033[90m to see available commands.\033[0m"
        echo -e ""
        exit 1
    ;;
esac